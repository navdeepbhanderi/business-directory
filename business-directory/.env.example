# ---------------------------------------------------------------------------
# Local development
#
#   npm run db:start        starts local Supabase and prints these values
#   cp .env.example .env.local
# ---------------------------------------------------------------------------

# Supabase — safe to expose to the browser (RLS is the security boundary)
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Server only. BYPASSES RLS — never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=""

# Canonical origin, used for metadata, sitemap, and OG image URLs
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Added in later phases -------------------------------------------------
# RESEND_API_KEY=""                  # Phase 9  transactional email
# STRIPE_SECRET_KEY=""               # Phase 11 test mode only
# STRIPE_WEBHOOK_SECRET=""           # Phase 11
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
